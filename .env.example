# cloudshift-plane-mcp — 配置示例
# 复制为 .env 后修改。不要提交 .env。
# 服务启动时会读取当前工作目录（或其上级目录）的 .env；已存在的系统环境变量优先。

# -----------------------------------------------------------------------------
# Plane 连接（必填）
# -----------------------------------------------------------------------------
# Plane 地址，不带 /api（SDK 会自动追加 /api/v1）。
# Plane Cloud：https://api.plane.so
PLANE_BASE_URL=https://plane.example.com

# 可选：服务端访问 Plane 的内部地址（如内网域名）。默认等于 PLANE_BASE_URL。
# PLANE_INTERNAL_BASE_URL=http://plane-api:8000

# -----------------------------------------------------------------------------
# HTTP 服务（仅 `plane-mcp-server http`）
# -----------------------------------------------------------------------------
# 每个请求使用调用者自己的 Plane API Key，workspace 由每次工具调用的
# workspace_slug 参数决定，所以服务端不需要配置 Key 和 workspace。
MCP_HOST=0.0.0.0
MCP_PORT=8211
# 所有路由加前缀，用于子路径反向代理。
# MCP_PATH_PREFIX=

# 只提供 /http/api-key/... 路由，不暴露 OAuth 发现端点（推荐）。
PLANE_MCP_DISABLE_OAUTH=true

# 允许仅用 URL 连接的客户端（Claude.ai 自定义连接器）访问 /http/api-key/w/<workspace>/mcp。
# 开启后，没带凭据的请求会使用服务端的 PLANE_API_KEY，任何能访问该 URL 的人都获得这把 Key 的权限，
# 只能在内网或带认证的代理后面开启。每人一个 Key 的用法下保持 false。
PLANE_MCP_ALLOW_URL_ONLY_AUTH=false

# -----------------------------------------------------------------------------
# 仅 stdio 模式，或开启 URL-only 认证时才需要
# -----------------------------------------------------------------------------
# HTTP 每人一个 Key 的用法下请不要配置 PLANE_API_KEY：
# 配置后，Plane 暂时不可用（502/503）时，带有相同 Key 的请求会被直接放行。
# PLANE_API_KEY=
# PLANE_WORKSPACE_SLUG=my-workspace

# -----------------------------------------------------------------------------
# OAuth（仅当 PLANE_MCP_DISABLE_OAUTH=false）
# -----------------------------------------------------------------------------
# 本 MCP 服务自己的公网地址（不是 Plane 的地址）。
# PLANE_OAUTH_PROVIDER_BASE_URL=https://mcp.example.com
# PLANE_OAUTH_PROVIDER_CLIENT_ID=
# PLANE_OAUTH_PROVIDER_CLIENT_SECRET=
# PLANE_OAUTH_PROVIDER_ENABLE_CIMD=false
# 追加到内置白名单的回调地址模式（逗号分隔）。
# PLANE_OAUTH_ALLOWED_REDIRECT_URIS=https://newclient.example/cb

# OAuth 令牌存储（不配置 Redis 时使用内存，重启丢失）。
# REDIS_HOST=localhost
# REDIS_PORT=6379
# REDIS_PASSWORD=

# -----------------------------------------------------------------------------
# 报告（cloudshift_plane_* 工具）
# -----------------------------------------------------------------------------
# 计算"今天"、逾期、即将到期时使用的 IANA 时区。
CLOUDSHIFT_TIMEZONE=UTC
# 未完成且超过这么多天没更新的工作项标记为陈旧。
CLOUDSHIFT_STALE_TASK_DAYS=5
# 在这么多小时内到期的工作项标记为即将到期。
CLOUDSHIFT_DUE_SOON_HOURS=48
# 表示"被阻塞"的标签（逗号分隔，不区分大小写）。
CLOUDSHIFT_BLOCKED_LABEL_NAMES=blocked,blocker,blocking

# -----------------------------------------------------------------------------
# 日志
# -----------------------------------------------------------------------------
# 日志中包含显示名（个人信息）。默认 false。
# LOG_USER_INFO=false
